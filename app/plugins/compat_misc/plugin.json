{
  "manifest_version": 1,
  "id": "compat_misc",
  "name": "旧前端兼容·杂项只读",
  "version": "0.1.0",
  "min_core_version": "0.3.1",
  "enabled": true,
  "kind": "compat",
  "backend": {
    "module": "backend",
    "entry": "register",
    "mount": "root",
    "timeout_ms": 20000,
    "permissions": [
      "read:panel",
      "read:db",
      "quotes:read"
    ]
  },
  "data": {
    "read": [
      "amv_board.db",
      "ths_board.db",
      "buy_signal.db"
    ],
    "panel": [
      "real_positions",
      "watchlist",
      "selection_latest",
      "selection_live",
      "selection_pool",
      "selection_filter",
      "etf_snapshot_latest"
    ],
    "json": [],
    "lib": [
      "indicators"
    ],
    "quotes": true,
    "write": [
      "selection_filter",
      "selection_pool"
    ]
  },
  "config": {},
  "depends": []
}
